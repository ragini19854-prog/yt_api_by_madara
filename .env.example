# Railway runtime variables
PORT=8080
NODE_ENV=production
FRONTEND_DIST_DIR=/app/public

# Clerk authentication
# VITE_CLERK_PUBLISHABLE_KEY is embedded into the frontend at Docker build time.
# Set it in Railway before the first deploy and redeploy after changing it.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=replace_with_clerk_secret_key

# Optional: retained for local/session integrations that use it.
SESSION_SECRET=replace_with_a_long_random_value

# No DATABASE_URL is required for the current free-plan local-library mode.