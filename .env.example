# ─────────────────────────────────────────────────────────────────
#  Madara Music — Environment Variables
#  Copy to .env and fill in real values before starting docker-compose
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password

# ── Session ──────────────────────────────────────────────────────
SESSION_SECRET=changeme_random_64_char_string

# ── Clerk Auth (https://dashboard.clerk.com) ─────────────────────
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── API base URL (for the frontend build) ────────────────────────
# Set to your domain if using a CDN/proxy, otherwise leave as /api
VITE_API_BASE_URL=/api
